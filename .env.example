# Required for LLM features (Summarization, extraction, RAG)
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: for Hinglish transcription via Sarvam AI
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: Whisper model size (tiny, base, small, medium, large - default: small)
WHISPER_MODEL=small

# Optional: Sarvam model version
SARVAM_STT_MODEL=saaras:v2.5
